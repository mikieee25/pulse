# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional public origin used for absolute metadata URLs.
NEXT_PUBLIC_APP_URL=https://your-pulse-domain.example

# Server-only key used by dashboard snapshots, cached reference data,
# notifications, activity/presence tracking, and Admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional comma-separated origins allowed by next dev for LAN development.
PULSE_ALLOWED_DEV_ORIGINS=192.168.1.10
